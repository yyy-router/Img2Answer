IMG2ANSWER_DATABASE=data/processed/img2answer.sqlite3
IMG2ANSWER_CHROMA_DIR=data/processed/chroma
# Leave empty to use the embedding model's default collection.
IMG2ANSWER_CHROMA_COLLECTION=
# Separate collection for index-questions and POST /search/question.
IMG2ANSWER_QUESTION_CHROMA_COLLECTION=
# Only images inside this directory can be returned by /image-content/{id}.
IMG2ANSWER_IMAGE_ROOT=data/processed
IMG2ANSWER_EMBEDDING_MODEL=pillow-hash
IMG2ANSWER_TOP_K=5
IMG2ANSWER_MAX_UPLOAD_BYTES=10485760

# Optional Aliyun OCR; only --ocr enables cloud calls.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
IMG2ANSWER_OCR_CONNECT_TIMEOUT_SECONDS=5
IMG2ANSWER_OCR_READ_TIMEOUT_SECONDS=30
IMG2ANSWER_OCR_MIN_CONFIDENCE=80
